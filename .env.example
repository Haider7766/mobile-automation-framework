# Copy this file to ".env" and fill it in.   NEVER commit ".env" (it is git-ignored).
# In CI, set these as pipeline secrets instead of using a file.

# --- Mobile sample app (WebdriverIO native demo app: any valid email / 8+ char password works) ---
MOBILE_EMAIL=test@webdriver.io
MOBILE_PASSWORD=Test1234!
NOTEFLOW_SIGNUP_PASSWORD=
# --- Android (all optional) ---
ANDROID_DEVICE_NAME=Android Emulator
# ANDROID_PLATFORM_VERSION=14
# ANDROID_UDID=emulator-5554
# ANDROID_APP=apps/android.wdio.native.app.v2.2.0.apk      # path or https:// URL to YOUR build

# --- iOS (all optional, macOS + Xcode only) ---
# IOS_DEVICE_NAME=iPhone 16
# IOS_PLATFORM_VERSION=18.0
# IOS_APP=apps/ios.simulator.wdio.native.app.v2.2.0.zip

