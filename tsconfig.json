{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "@wdio/globals/types", "expect-webdriverio", "@wdio/mocha-framework"]
  },
  "include": ["config/**/*.ts", "locators/**/*.ts", "pages/**/*.ts", "tests/**/*.ts", "data/**/*.ts", "utils/**/*.ts"],
  "exclude": ["node_modules", "reports"]
}
