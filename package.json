{
  "name": "mobile-automation-framework",
  "version": "1.0.0",
  "description": "WebdriverIO + Appium + TypeScript test framework (Android, iOS and web) built on the Page Object Model",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "get:app:android": "node scripts/download-sample-app.mjs android",
    "get:app:ios": "node scripts/download-sample-app.mjs ios",
    "doctor:android": "appium driver doctor uiautomator2",
    "doctor:ios": "appium driver doctor xcuitest",
    "test:android": "wdio run config/wdio.android.conf.ts",
    "test:ios": "wdio run config/wdio.ios.conf.ts",
    "install:app": "node scripts/install-app.mjs"

  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@wdio/appium-service": "^10.0.0",
    "@wdio/cli": "^10.0.0",
    "@wdio/globals": "^10.0.0",
    "@wdio/junit-reporter": "^10.0.0",
    "@wdio/local-runner": "^10.0.0",
    "@wdio/mocha-framework": "^10.0.0",
    "@wdio/spec-reporter": "^10.0.0",
    "@wdio/types": "^10.0.0",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "appium-xcuitest-driver": "^12.15.0",
    "dotenv": "^18.0.5",
    "expect-webdriverio": "^8.0.0-alpha.3",
    "typescript": "^7.0.2",
    "webdriverio": "^10.0.0"
  }
}
